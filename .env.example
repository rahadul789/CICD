NODE_ENV=development
APP_NAME=node-observability-deployment-lab
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=false

# Docker Compose host ports. Change these if a local port is already busy.
APP_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
LOKI_HOST_PORT=3100

# MongoDB Atlas:
# Keep the real URI in .env only. Never commit production credentials.
# Example format:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Host machine local MongoDB for npm run dev:
# MONGO_URI=mongodb://127.0.0.1:27017/node_observability_lab
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/node_observability_lab?retryWrites=true&w=majority
# Use * for local learning. In production set your frontend/domain origin.
CORS_ORIGIN=*

# Keep this false unless you are intentionally testing failures locally.
ENABLE_CHAOS_ROUTES=false
CHAOS_MAX_DELAY_MS=10000
CHAOS_MAX_CPU_MS=5000
CHAOS_MAX_MEMORY_MB=100
